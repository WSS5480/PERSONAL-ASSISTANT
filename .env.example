# Copy to .env for local dev (npm run dev loads it). On Render, set these under Environment.
# Everything is optional locally; the app boots and explains what's missing.

# Owner's Anthropic key (house key). Other users get their own key in the Admin console.
ANTHROPIC_API_KEY=
# Model id. Default: claude-sonnet-5-5
ASSISTANT_MODEL=claude-sonnet-5-5
# Postgres connection string. Leave empty locally to use the embedded database (./.pglite-data).
DATABASE_URL=
# Long random string. Signs session cookies and encrypts stored keys/tokens. Required in production. Never change it after go-live.
SESSION_SECRET=
# Invite code for self sign-up after the first (owner) account. Empty = sign-up closed (owner's personal instance).
# Only this email can create the first (owner) account. Set it before the first deploy.
OWNER_EMAIL=
SIGNUP_CODE=
# Public URL of the app, no trailing slash, e.g. https://my-assistant.onrender.com (needed for Google sign-in).
APP_URL=http://localhost:3000
# Google OAuth client (Web application). Redirect URI: APP_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domo instance name only, e.g. acme for https://acme.domo.com
DOMO_INSTANCE=
# Owner's read-only GitHub token (fine-grained, Contents: read + Metadata: read).
GITHUB_TOKEN=
# Owner's Render API key (Apps screen + Render tools, owner only).
RENDER_API_KEY=

# Domo Assistant (the chat card inside Domo, files in domo-assistant/)
# Shared key the Domo app sends; must equal APP_KEY in domo-assistant/app.js at publish time.
DOMO_APP_KEY=
# Optional separate Claude key for Domo staff usage (falls back to ANTHROPIC_API_KEY).
DOMO_ANTHROPIC_API_KEY=
# Optional cap on Domo Assistant requests per day (default 2000).
DOMO_DAILY_LIMIT=
